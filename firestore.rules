rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Kinun — Firestore security rules
//
// Access model (see docs/DATA-MODEL.md):
//   Kinun is PRIVATE: only the Google accounts in `allowlist()` may use it at all (keep it in
//   sync with src/lib/access.ts). On top of that, a household document lists the emails allowed
//   in (`memberEmails`, lower-case, always a subset of the allowlist). A VERIFIED, allowlisted
//   account on that list can read and write the household and its sub-collections.
//   Everyone else sees nothing and can create nothing.
//
// Tests: firestore-tests/rules.test.ts (`npm run test:rules`, runs in CI with the emulator).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // The only Google accounts that may use Kinun (lower-case). Mirror of src/lib/access.ts.
    function allowlist() {
      return ['yishai.k@gmail.com', 'yishaik@gmail.com', 'lisya.abulafya@gmail.com'];
    }

    function allowed() {
      return verified() && myEmail() in allowlist();
    }

    function isMember(data) {
      return allowed() && myEmail() in data.memberEmails;
    }

    function householdIsValid(data) {
      return data.keys().hasOnly([
          'name', 'ownerUid', 'memberEmails', 'members', 'dueDate', 'birthDate', 'babyName',
          'hospital', 'contentVersion', 'dismissedSeedIds', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerUid is string
        && data.memberEmails is list
        && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 10
        && data.memberEmails.hasOnly(allowlist());
    }

    function itemIsValid(data) {
      return data.keys().hasOnly([
          'kind', 'title', 'notes', 'category', 'phase', 'done', 'order', 'links', 'source', 'seedId',
          'dueWeek', 'dueDaysAfterBirth', 'assignee', 'gearStatus', 'priority', 'quantity', 'price',
          'url', 'phone', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'doneAt', 'doneBy'])
        && data.kind in ['task', 'gear', 'bag', 'link']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.notes is string && data.notes.size() <= 5000
        && data.done is bool;
    }

    function contractionIsValid(data) {
      return data.keys().hasOnly(['start', 'end', 'createdBy'])
        && data.keys().hasAll(['start', 'createdBy'])
        && data.start is number
        && (data.get('end', null) == null || data.end is number)
        && data.createdBy is string && data.createdBy.size() <= 128;
    }

    // Kick sessions, the birth plan, doctor questions, names and the journal (src/lib/types.ts →
    // HouseholdRecord). Text only — the Spark plan has no Storage, so no photos.
    function recordIsValid(data) {
      return data.keys().hasOnly([
          'kind', 'text', 'note', 'done', 'tag', 'date', 'start', 'end', 'count', 'votes', 'answers',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['kind', 'text', 'note', 'done', 'votes', 'answers', 'createdBy'])
        && data.kind in ['kick', 'birthPlan', 'question', 'name', 'journal']
        && data.text is string && data.text.size() <= 10000
        && data.note is string && data.note.size() <= 2000
        && data.done is bool
        && (data.get('tag', null) == null || (data.tag is string && data.tag.size() <= 40))
        && (data.get('date', null) == null || (data.date is string && data.date.size() == 10))
        && (data.get('start', null) == null || data.start is number)
        && (data.get('end', null) == null || data.end is number)
        && (data.get('count', null) == null || (data.count is int && data.count >= 0 && data.count <= 999))
        && data.votes is map && data.votes.size() <= 10
        && data.answers is map && data.answers.size() <= 60
        && data.createdBy is string && data.createdBy.size() <= 128;
    }

    // Each member may only set or clear their OWN vote on a name, and only to 'love' / 'no'.
    function votesOk(before, after) {
      let changed = after.votes.diff(before.votes).affectedKeys();
      return changed.size() == 0
        || (changed.hasOnly([request.auth.uid])
          && (!(request.auth.uid in after.votes) || after.votes[request.auth.uid] in ['love', 'no']));
    }

    match /households/{householdId} {
      // `list` works for the app's query: where('memberEmails', 'array-contains', <my email>).
      allow get, list: if isMember(resource.data);

      allow create: if allowed()
        && request.resource.data.ownerUid == request.auth.uid
        && myEmail() in request.resource.data.memberEmails
        && householdIsValid(request.resource.data);

      // Members may change anything except who owns the household and when it was created.
      allow update: if isMember(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && householdIsValid(request.resource.data);

      allow delete: if allowed() && resource.data.ownerUid == request.auth.uid;

      function memberOfThisHousehold() {
        return isMember(get(/databases/$(database)/documents/households/$(householdId)).data);
      }

      match /items/{itemId} {
        allow read, delete: if memberOfThisHousehold();
        allow create, update: if memberOfThisHousehold() && itemIsValid(request.resource.data);
      }

      match /contractions/{contractionId} {
        allow read, delete: if memberOfThisHousehold();
        allow create, update: if memberOfThisHousehold() && contractionIsValid(request.resource.data);
      }

      match /records/{recordId} {
        allow read, delete: if memberOfThisHousehold();
        allow create: if memberOfThisHousehold()
          && recordIsValid(request.resource.data)
          && request.resource.data.votes.keys().hasOnly([request.auth.uid]);
        allow update: if memberOfThisHousehold()
          && recordIsValid(request.resource.data)
          && request.resource.data.kind == resource.data.kind
          && votesOk(resource.data, request.resource.data);
      }
    }
  }
}
