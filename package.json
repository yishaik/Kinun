{
  "name": "kinun",
  "private": true,
  "version": "1.0.0",
  "description": "קינון — אפליקציה משותפת לזוג שמתכונן ללידה: משימות, ציוד, תיק לידה, טיימר צירים וקישורים חשובים. PWA + Firebase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-kinun \"vitest run --config vitest.rules.config.ts\"",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "deploy": "npm run build && npx -y firebase-tools@15 deploy",
    "deploy:rules": "npx -y firebase-tools@15 deploy --only firestore",
    "firebase": "npx -y firebase-tools@15"
  },
  "dependencies": {
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource/suez-one": "^5.3.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
